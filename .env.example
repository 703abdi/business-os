TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
# Optional: ring this phone first; a call counts as missed if nobody picks up in time.
TELNYX_FORWARD_TO=
TELNYX_FORWARD_TIMEOUT_SECS=
